# Copy to .env / apps/web/.env.local / apps/api/.dev.vars. NEVER commit real values.
# Names match GitHub repo variables/secrets.

# --- Supabase (repo variables) ---
SUPABASE_URL=https://nklbdyezbsugkdvaidtt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_REF=nklbdyezbsugkdvaidtt
# --- Supabase (secrets) ---
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_ACCESS_TOKEN=sbp_xxx

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_API_TOKEN=xxx

# --- Google OAuth (client secret lives only in Supabase Auth provider settings) ---
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com

# --- Web ---
NEXT_PUBLIC_SITE_URL=https://sparkle.example   # production domain TBD
NEXT_PUBLIC_API_URL=http://localhost:8787   # sparkle-api worker URL

# API crash reporting (optional, SA-17 / DEC-184). Leave empty = no-op. Set as a Worker secret, never commit.
SENTRY_DSN=
