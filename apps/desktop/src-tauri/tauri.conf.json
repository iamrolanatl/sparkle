{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparkle Sync Agent",
  "version": "0.1.0",
  "identifier": "app.sparkle.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Sparkle Sync Agent",
        "width": 720,
        "height": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://sparkle-api.crystal-iamrolan.workers.dev"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
